# ForgeExec Environment Configuration
# Copy this file to .env and configure with your actual values

# =================================================
# API Server Configuration
# =================================================
PORT=3000

# =================================================
# Daily Export Configuration
# =================================================

# --- Local File Storage ---
# Where to save daily exports on the local filesystem
EXPORT_DIR=./exports

# --- Email Delivery ---
# Set to 'true' to enable automated email delivery
EMAIL_ENABLED=false

# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email addresses
SMTP_FROM=noreply@nextlevelelectric.com
SMTP_TO=office@nextlevelelectric.com,accounting@nextlevelelectric.com

# --- Cloud Storage (SharePoint/OneDrive) ---
# Set to 'true' to enable cloud storage backup
CLOUD_ENABLED=false

# Cloud storage type: 'sharepoint' or 'onedrive'
CLOUD_TYPE=onedrive

# Microsoft Graph API access token
# See: https://docs.microsoft.com/en-us/graph/auth/
CLOUD_ACCESS_TOKEN=

# SharePoint site ID (required for SharePoint, optional for OneDrive)
CLOUD_SITE_ID=

# Drive ID (optional, uses default drive if not specified)
CLOUD_DRIVE_ID=

# Folder path in cloud storage (will be created if doesn't exist)
CLOUD_FOLDER_PATH=ForgeExec/Exports

# =================================================
# Scheduler Configuration
# =================================================

# ForgeExec API URL (used by scheduler)
FORGEEXEC_API_URL=http://localhost:3000

# Cron schedule for daily export (default: 11:59 PM daily)
# Format: minute hour day month weekday
# Examples:
#   59 23 * * *    = Every day at 11:59 PM
#   0 0 * * *      = Every day at midnight
#   0 12 * * *     = Every day at noon
EXPORT_SCHEDULE=59 23 * * *

# Run export immediately when scheduler starts (for testing)
RUN_ON_STARTUP=false

# =================================================
# Email Configuration Examples
# =================================================

# --- Gmail ---
# 1. Enable 2FA on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password as SMTP_PASS
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password

# --- Office 365 / Outlook ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your-email@yourdomain.com
# SMTP_PASS=your-password

# --- Custom SMTP Server ---
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=user@yourdomain.com
# SMTP_PASS=your-password

# =================================================
# Notes
# =================================================
#
# Business Continuity Protection:
# - At minimum, keep EXPORT_DIR enabled (local file storage)
# - For maximum resilience, enable all three delivery paths:
#   1. Local file storage (always enabled)
#   2. Email delivery (set EMAIL_ENABLED=true)
#   3. Cloud storage (set CLOUD_ENABLED=true)
#
# This ensures your data is preserved even if:
# - The app/UI goes down
# - Email delivery fails
# - Cloud storage is unavailable
#
# Data Safety:
# - Exports are immutable and timestamped
# - Organized by date: exports/2026/2026-01-06/
# - Never overwrites existing exports
# - Safe to run multiple times per day
